NODE_ENV=development
PORT=3000
POSTGRES_USER=chat_backend
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=chat_backend
DATABASE_URL="postgresql://chat_backend:replace_with_a_local_password@localhost:5432/chat_backend?schema=public"

# Leave all three Firebase values blank to disable Firebase Admin outside the emulator.
# Set all three when connecting to a real Firebase project; never commit real credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
